# dependencies
node_modules/

# build output
dist/

# env & secrets
.env
.env.*
!.env.example

# Dependency lockfile.
#
# Deliberately NOT committed. This project is developed behind a corporate npm
# proxy, so a lockfile generated here pins every package to an internal host AND
# carries that proxy's integrity hashes (sha1, where public npm serves sha512) —
# publishing it would both leak internal infrastructure and hand outside users a
# lockfile whose `npm ci` integrity checks cannot pass. A lockfile that only
# works for its author is worse than none.
package-lock.json

# data / local state
data/
*.db
*.db-shm
*.db-wal

# Per-instance start wrapper generated by the residency installer
# (scripts/lib/residency.mjs writes scripts/run-bot.<instance>.ps1). It hardcodes
# THIS machine's absolute paths — the node binary, the repo root, the copilot/git
# directories and a log path under the user's home — so committing one would leak
# a username and be wrong on every other machine. Regenerated by the installer.
scripts/run-bot.*.ps1

# logs
*.log
npm-debug.log*

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
