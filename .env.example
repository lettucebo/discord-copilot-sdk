# discord-copilot-sdk — ⚠️ LAB-ONLY (v1). Run ONLY in a disposable VM / test account / throwaway repo.
# The agent can run shell commands and edit files on the host; v1 has no controller/worker
# isolation. Do NOT point this at an important machine or repository.

# --- Discord ---
DISCORD_BOT_TOKEN=
# Comma-separated Discord user IDs allowed to interact (owner only for v1).
DISCORD_ALLOWED_USER_IDS=
# Required: only this guild is honored.
DISCORD_GUILD_ID=
# Required: seed default (first-run) work-channel; auto-authorized only the first time the
# bot starts, then becomes an ordinary removable registry entry (use a private channel; audit
# enabled channels with /channel list).
DISCORD_PARENT_CHANNEL_ID=

# --- Copilot sessions: which repos, and how ---
# Absolute path to the folder that CONTAINS your repos (e.g. C:\Source\Repos).
# It must NOT itself be a git repo — that's the folder ONE level up from a clone.
# It also must not contain, or sit inside, ~/.discord-copilot-sdk.
REPOS_ROOT=
# Optional: the repo under REPOS_ROOT that `/new` binds to when you don't pass
# `repo:`. A NAME, not a path (e.g. `career-ops`). Leave empty to require
# `/new repo:<name>` every time.
DEFAULT_REPO=
DEFAULT_MODEL=claude-sonnet-5
# default | long_context   (long_context unlocks the model's large window, e.g. ~936K)
DEFAULT_CONTEXT_TIER=default
# Names each new thread from its first message using a small, cheap model in a
# throwaway session. Leave empty to auto-pick (gemini-3.5-flash > claude-haiku-4.5
# > gpt-5-mini > gpt-5.4-mini); set to `off` to fall back to a truncated first line.
TITLE_MODEL=
# Explicit skill roots are loaded without enabling .mcp.json/.vscode/mcp.json discovery.
# WARNING: repository skill names and descriptions enter the agent context, even before invocation.
# Set false to keep user skills while removing .github/skills, .agents/skills and .claude/skills.
ENABLE_REPO_SKILLS=true
# User-owned ~/.copilot/skills is shared by all sessions on this OS account.
# Set false to remove it while keeping enabled repository skill roots.
ENABLE_USER_SKILLS=true

# --- /repo clone ---
# Which hosts `/repo clone` may fetch from.
#   github    = only github.com (default, and the only value that needs no thought)
#   allowlist = only the hosts named in REPO_CLONE_ALLOWED_HOSTS
# There is deliberately no "any public host" option: a hostname alone cannot
# prove a host is external — DNS can point anywhere. Internal/loopback/metadata
# addresses are refused under every policy.
REPO_CLONE_HOST_POLICY=github
# Comma-separated hostnames, required when REPO_CLONE_HOST_POLICY=allowlist.
REPO_CLONE_ALLOWED_HOSTS=
# Per clone/init timeout in ms before the process tree is killed.
REPO_CLONE_TIMEOUT_MS=300000
