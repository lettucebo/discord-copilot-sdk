# discord-copilot-sdk — ⚠️ LAB-ONLY (v1). Run ONLY in a disposable VM / test account / throwaway repo.
# The agent can run shell commands and edit files on the host; v1 has no controller/worker
# isolation. Do NOT point this at an important machine or repository.

# --- Discord ---
DISCORD_BOT_TOKEN=
# Comma-separated Discord user IDs allowed to interact (owner only for v1).
DISCORD_ALLOWED_USER_IDS=
# Required: only this guild is honored.
DISCORD_GUILD_ID=
# Required: only threads created under this parent channel are honored (use a private channel).
DISCORD_PARENT_CHANNEL_ID=
# Optional: a dev guild id for instant slash-command registration during development.
DEV_GUILD_ID=

# --- Copilot session (v1: a single controlled repo) ---
# Absolute path to the ONE disposable repo the session is allowed to work in.
CONTROLLED_REPO_PATH=
DEFAULT_MODEL=claude-sonnet-5
# default | long_context   (long_context unlocks the model's large window, e.g. ~936K)
DEFAULT_CONTEXT_TIER=default
# Names each new thread from its first message using a small, cheap model in a
# throwaway session. Leave empty to auto-pick (gemini-3.5-flash > claude-haiku-4.5
# > gpt-5-mini > gpt-5.4-mini); set to `off` to fall back to a truncated first line.
TITLE_MODEL=
# How concurrent sessions get their working directory.
#   (empty)  = auto: `worktree` when CONTROLLED_REPO_PATH is a git repo, else `shared`
#   worktree = each session gets its own git worktree (safe to run many at once)
#   shared   = every session edits the SAME checkout, so only ONE is safe at a
#              time; /new then ends the previous session
SESSION_ISOLATION=

# --- Safety ---
# v1 only supports "ask" (approve-once / deny). No auto-approve.
PERMISSION_POLICY=ask
