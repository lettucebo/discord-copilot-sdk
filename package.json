{
  "name": "discord-copilot-sdk",
  "version": "1.0.1",
  "private": true,
  "description": "Control your local GitHub Copilot from Discord via the official @github/copilot-sdk.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "smoke:live": "npm run build && node scripts/smoke-live.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "setup": "node scripts/setup.mjs",
    "update": "node scripts/update.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.7-preview.3",
    "discord.js": "^14.16.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^4.1.7"
  }
}
