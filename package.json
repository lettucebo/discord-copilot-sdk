{
  "name": "discopilot",
  "version": "0.0.1",
  "private": true,
  "description": "Control your local GitHub Copilot from Discord via the official @github/copilot-sdk.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.7-preview.3",
    "discord.js": "^14.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^4.1.7"
  }
}
